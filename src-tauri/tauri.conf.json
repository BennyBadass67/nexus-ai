{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS AI",
  "version": "1.6.0",
  "identifier": "no.nexus.ai",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nexus-backend"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "Norwegian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "icons/icon.ico": "nexus-ai.ico"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBODE5MkZGNDQxREQ0NTMKUldSVDFCMUUvNUtCR3BDOTJsT3F6UzFFS0Z2aTgweEIwc2tzbHh5VHRPaUFtaEd4YjZzdmo2UjkK",
      "endpoints": [
        "https://github.com/BennyBadass67/nexus-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}